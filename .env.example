# N.A.T. AI Assistant v1 Configuration
# Copy this to .env and fill in your API keys

# Groq API Keys (multiple for rate limit rotation)
GROQ_API_KEY_1=your_groq_api_key_here
GROQ_API_KEY_2=your_groq_api_key_2_here
GROQ_API_KEY_3=your_groq_api_key_3_here
GROQ_API_KEY_4=your_groq_api_key_4_here
GROQ_API_KEY_5=your_groq_api_key_5_here
GROQ_API_KEY_6=your_groq_api_key_6_here

# Model Configuration
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Tavily Search API (for real-time search)
TAVILY_API_KEY=your_tavily_api_key_here

# Cohere API (backup)
COHERE_API_KEY=your_cohere_api_key_here

# User Configuration
YOUR_NAME=YourName
ASSISTANT_NAME=N.A.T.

# Vector Store Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=database/vector_store

# Learning Data
LEARNING_DATA_PATH=database/learning_data

# Chat History
CHATS_PATH=database/chats_data
